# Realtime updates through Laravel Reverb (pusher protocol). Copy to .env.local and
# use the values of REVERB_APP_KEY / REVERB_HOST / REVERB_PORT / REVERB_SCHEME from backend/.env.
# Leave VITE_REVERB_APP_KEY empty to turn realtime off; the app works without it.
VITE_REVERB_APP_KEY=
VITE_REVERB_HOST=localhost
VITE_REVERB_PORT=8080
VITE_REVERB_SCHEME=http
