# Settings of a production installation. Copy to .env.production and fill in.
# Lines marked REQUIRED have no usable default.

# ── The address ───────────────────────────────────────────────────────────────
# REQUIRED. The public address, the same for the web app and the API.
APP_URL=https://yadeit.example.com
FRONTEND_URL=https://yadeit.example.com
# REQUIRED. The host part of the address (with the port, if it is not 80 or 443).
SANCTUM_STATEFUL_DOMAINS=yadeit.example.com
# Cookies only over HTTPS. Set to false only for a trial on plain HTTP.
SESSION_SECURE_COOKIE=true

# How the container listens: ":8080" behind your own proxy (publish HTTP_PORT),
# or your domain to let it obtain a certificate and speak HTTPS itself.
SERVER_NAME=:8080
HTTP_PORT=8080
# The addresses of the proxy in front, so that the caller's own address is used
# for limits and the audit log (or * when the container is reachable only through it).
TRUSTED_PROXIES=

# ── Secrets ───────────────────────────────────────────────────────────────────
# REQUIRED. Generate with: docker run --rm --entrypoint php yadeit artisan key:generate --show
APP_KEY=
# REQUIRED. The database is created with these on first start.
DB_DATABASE=yadeit
DB_USERNAME=yadeit
DB_PASSWORD=

APP_NAME=Yadeit
APP_ENV=production
APP_DEBUG=false
LOG_CHANNEL=stderr
LOG_LEVEL=info

SESSION_DRIVER=database
QUEUE_CONNECTION=database
CACHE_STORE=database

# ── Email ─────────────────────────────────────────────────────────────────────
# REQUIRED for sign-up: people confirm their address by email.
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=hello@yadeit.example.com
MAIL_FROM_NAME=Yadeit

# ── Who runs it ───────────────────────────────────────────────────────────────
# Shown on the terms and privacy pages. Built into the web app: rebuild after changing.
OPERATOR_NAME=
OPERATOR_EMAIL=

# ── Monitoring and backups ────────────────────────────────────────────────────
# GET /health answers to "Authorization: Bearer <this>" with 200 or 503. Empty switches it off.
HEALTH_TOKEN=
BACKUP_KEEP_DAYS=14
BACKUP_INTERVAL_HOURS=24

# ── Optional features ─────────────────────────────────────────────────────────
# Built-in AI for workspaces without their own key.
ANTHROPIC_API_KEY=

# Paid plans. PLAN_LIMITS=true applies the limits of config/plans.php.
PLAN_LIMITS=false
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_TEAM=

# Realtime updates: start the reverb service (--profile realtime) and fill these in.
# The VITE_ values are built into the web app; the key must match REVERB_APP_KEY.
BROADCAST_CONNECTION=null
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=reverb
REVERB_PORT=8080
REVERB_SCHEME=http
VITE_REVERB_APP_KEY=
VITE_REVERB_HOST=yadeit.example.com
VITE_REVERB_PORT=443
VITE_REVERB_SCHEME=https
